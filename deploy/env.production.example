# EventFlow production configuration (K-720). Copy to deploy/.env.production on the server, fill in, and
# keep it out of Git (it is ignored) and readable only by the operator. Variables: docs/operations/ENVIRONMENT.md.

# Release and domain
EVENTFLOW_VERSION=
EVENTFLOW_DOMAIN=events.example.org
PUBLIC_ORIGIN=https://events.example.org
NODE_ENV=production
TRUST_PROXY_HOPS=1

# Database passwords (used by compose.yaml to build the connection strings)
POSTGRES_SUPERUSER_PASSWORD=
APP_OWNER_PASSWORD=
APP_RUNTIME_PASSWORD=

# Secrets: 32 random bytes or more each, for example: openssl rand -hex 32
CSRF_SECRET=
PRESESSION_SECRET=
RATE_LIMIT_SECRET=
PREVIEW_SECRET=
# Super Admin second factor: 32 random bytes, base64 (openssl rand -base64 32)
ADMIN_TOTP_KEY=

# Email (Resend; a verified sending domain)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=EventFlow <events@events.example.org>
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Participant map (optional; OpenStreetMap's tile service is not for production traffic: see PD-96)
# MAP_TILE_URL=
# MAP_TILE_CONTACT=
