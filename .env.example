# Copy to .env and replace every <placeholder>. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# The browser origin (the Vite dev server in development). State-changing requests must come from it.
PUBLIC_ORIGIN=http://localhost:5173

# Runtime role (web and worker) and owner role (migrations only); see scripts/provision-local-db.sql.
DATABASE_URL=postgres://app_runtime:<runtime-password>@localhost:5432/ers_dev
MIGRATION_DATABASE_URL=postgres://app_owner:<owner-password>@localhost:5432/ers_dev
# Integration tests use a separate database; its "app" schema is dropped and recreated on each run.
TEST_DATABASE_URL=postgres://app_runtime:<runtime-password>@localhost:5432/ers_test
TEST_MIGRATION_DATABASE_URL=postgres://app_owner:<owner-password>@localhost:5432/ers_test

# At least 32 random characters each, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=<random-64-hex>
PRESESSION_SECRET=<random-64-hex>
RATE_LIMIT_SECRET=<random-64-hex>
PREVIEW_SECRET=<random-64-hex>

# The fake provider writes emails to DEV_MAILBOX_DIR and shows them at /dev/mailbox (refused in production).
EMAIL_PROVIDER=fake
DEV_MAILBOX_DIR=var/mailbox
# Real email (K-717): EMAIL_PROVIDER=resend with a key and a sender on a domain verified in Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM=EventFlow <events@your-domain.example>
# EMAIL_REPLY_TO=help@your-domain.example
# Delivery webhooks (K-402): the signing secret of the Resend webhook endpoint /api/webhooks/resend.
# RESEND_WEBHOOK_SECRET=whsec_...

# Event images (K-712): a directory outside the repository; relative paths are from the repository root.
MEDIA_DIR=var/media

# Super Admin second factor (K-718): 32 random bytes, base64. Required in production; enrol with pnpm admin:totp.
# ADMIN_TOTP_KEY=
# ADMIN_REQUIRE_TOTP=true

# Participant map (K-714). Off until MAP_TILE_CONTACT is set: a contact URL or email address sent in the
# User-Agent of tile requests, as the OpenStreetMap Tile Usage Policy requires. Tiles are cached in TILE_CACHE_DIR.
# MAP_TILE_CONTACT=
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_CACHE_DIR=var/tile-cache
# Behind a reverse proxy (production: 1 behind Caddy), the number of proxies trusted for X-Forwarded-For.
# TRUST_PROXY_HOPS=0
# Backups (K-721): pnpm ops:restore-drill needs a role that may create databases; pg_dump 18 on PATH or in PG_BIN.
# RESTORE_ADMIN_URL=postgres://postgres:<superuser-password>@localhost:5432/postgres
# PG_BIN=
# Optional: serve the built client from the web process (after pnpm build), e.g. apps/client/dist
# CLIENT_DIST_DIR=apps/client/dist
