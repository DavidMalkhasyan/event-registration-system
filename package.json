{
  "name": "event-registration-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "migrate": "pnpm --filter @ers/server migrate",
    "dev:web": "pnpm --filter @ers/server dev:web",
    "dev:worker": "pnpm --filter @ers/server dev:worker",
    "dev:client": "pnpm --filter @ers/client dev"
  }
}
