{
  "name": "event-registration-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "migrate": "pnpm --filter @ers/server migrate",
    "admin:create": "pnpm --filter @ers/server admin create",
    "admin:disable": "pnpm --filter @ers/server admin disable",
    "dev:web": "pnpm --filter @ers/server dev:web",
    "dev:worker": "pnpm --filter @ers/server dev:worker",
    "dev:client": "pnpm --filter @ers/client dev",
    "start:web": "node --env-file-if-exists=.env apps/server/dist/entrypoints/web.js",
    "start:worker": "node --env-file-if-exists=.env apps/server/dist/entrypoints/worker.js",
    "e2e": "pnpm --filter @ers/e2e e2e",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:deps": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
